{
  "name": "@yudane/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "YUDANE モバイルアプリ（React Native + TypeScript + Expo）",
  "main": "index.ts",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "vitest run --dir src/test/contract",
    "mock:api": "npm run mock:api --workspace shared/schema",
    "start": "expo start --clear",
    "ios": "expo start --ios --clear",
    "android": "expo start --android --clear"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@yudane/safeguard-policy": "*",
    "@yudane/schema": "*",
    "@yudane/telemetry-contracts": "*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "nativewind": "^4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "tailwindcss": "^3.4.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "fast-check": "^3.23.0",
    "msw": "^2.7.0",
    "vitest": "^2.1.8"
  }
}
