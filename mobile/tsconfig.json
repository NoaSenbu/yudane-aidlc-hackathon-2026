{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "./",
    "rootDir": "./",
    "types": ["vitest/globals", "nativewind/types"],
    "paths": {
      "@yudane/schema": ["../shared/schema/types/api.ts"],
      "@yudane/safeguard-policy": ["../shared/safeguard-policy/src/index.ts"],
      "@yudane/telemetry-contracts": ["../shared/telemetry-contracts/src/index.ts"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "App.tsx", "index.ts"]
}
