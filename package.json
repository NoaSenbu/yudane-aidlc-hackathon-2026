{
  "name": "yudane",
  "version": "0.1.0",
  "private": true,
  "description": "YUDANE（委ね） — 買わない理由を論破する AI エージェント・コマース。モノレポルート",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "shared/schema",
    "shared/asin-extractor",
    "shared/safeguard-policy",
    "shared/telemetry-contracts",
    "mobile",
    "infra"
