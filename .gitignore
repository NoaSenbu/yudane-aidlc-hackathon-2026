# =====================================================
# YUDANE Repository — .gitignore
# =====================================================

# --- OS 固有ファイル ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- エディタ / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 認証情報・環境変数（AGENTS.md セキュリティ規約） ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.*
credentials.*
*.cred

# --- ログ ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.python-version
poetry.toml

# --- Node.js / npm / Yarn ---
node_modules/
.npm/
.yarn/
.pnp.*

# --- TypeScript / ビルドキャッシュ ---
*.tsbuildinfo
coverage/
.vitest/

# --- OpenAPI 生成物の扱い ---
# 生成型（shared/schema/types/api.ts, backend/src/common/models/api.py）は
# api-contracts.md §3 によりコミット必須。ここでは無視しない

# --- AWS CDK ---
cdk.out/
.cdk.staging/

# --- ビルド成果物 ---
dist/
out/
*.tgz
*.zip
