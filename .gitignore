# =====================================================
# YUDANE Repository — .gitignore
# =====================================================

# --- OS 固有ファイル ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- エディタ / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 認証情報・環境変数（AGENTS.md セキュリティ規約） ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.*
credentials.*
*.cred

# --- ログ ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.python-version
poetry.toml

# --- Node.js / npm / Yarn ---
node_modules/
.npm/
.yarn/
.pnp.*

# --- Flutter / Dart ---
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# 注: pubspec.lock は意図的にコミット対象（AGENTS.md 開発環境規約）

# --- AWS CDK ---
cdk.out/
.cdk.staging/

# --- ビルド成果物 ---
dist/
out/
*.tgz
*.zip
